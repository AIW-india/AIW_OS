# ==============================================================================
# AIW OS Environment Configuration Template
# NOTE: Copy this file to .env and configure values for your environment.
# NEVER commit .env or actual production credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# ==============================================================================
# Neon PostgreSQL Database Configuration
# Connect to your Neon development branch connection string:
# Format: postgresql://[user]:[password]@[endpoint-pooler-or-direct].neon.tech/[dbname]?sslmode=require
# ==============================================================================
DATABASE_URL="postgresql://user:password@ep-example-dev-pooler.us-east-2.aws.neon.tech/aiw_os_dev?sslmode=require"
# Direct URL used for migrations if using connection pooler (optional):
DIRECT_URL="postgresql://user:password@ep-example-dev.us-east-2.aws.neon.tech/aiw_os_dev?sslmode=require"

# ==============================================================================
# Authentication & Security (Phase 0 / Baseline)
# ==============================================================================
SESSION_SECRET="your-development-session-secret-change-in-production"
JWT_SECRET="your-development-jwt-secret-change-in-production"
