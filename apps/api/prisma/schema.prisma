generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal system metadata table from initial baseline.
model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_metadata")
}

// ==============================================================================
// ORGANISATIONS (MULTI-TENANT ROOT)
// ==============================================================================

model Organisation {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  legalName       String?  @map("legal_name")
  slug            String   @unique
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  timezone        String   @default("Asia/Kolkata")
  defaultCurrency String   @default("INR") @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users              User[]
  departments        Department[]
  designations       Designation[]
  roles              Role[]
  rolePermissions    RolePermission[]
  userRoles          UserRole[]
  projectMemberships ProjectMembership[]
  invitations        Invitation[]
  auditLogs          AuditLog[]

  // CRM relations
  leadSources        LeadSource[]
  pipelineStages     LeadPipelineStage[]
  lostReasonCategories LostReasonCategory[]
  leads              Lead[]
  customers          Customer[]
  followUps          FollowUp[]
  siteVisits         SiteVisit[]
  leadActivities     LeadActivity[]

  // Estimation & BOQ relations
  materialCategories MaterialCategory[]
  materials          Material[]
  labourCategories   LabourCategory[]
  labourRates        LabourRate[]
  boqTemplates       BoqTemplate[]
  estimates          Estimate[]
  quotations         Quotation[]

  // Project Management relations
  projects           Project[]
  projectMilestones  ProjectMilestone[]
  projectTasks       ProjectTask[]
  projectDocuments   ProjectDocument[]
  projectActivities  ProjectActivity[]
  milestoneTemplates ProjectMilestoneTemplate[]

  @@map("organisations")
}

// ==============================================================================
// AUTHENTICATION & USERS (BETTER AUTH COMPATIBLE + TENANT-AWARE)
// ==============================================================================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String?   @map("organisation_id") @db.Uuid
  email          String    @unique
  emailVerified  Boolean   @default(false) @map("email_verified")
  name           String
  image          String?
  phone          String?
  employeeCode   String?   @map("employee_code")
  departmentId   String?   @map("department_id") @db.Uuid
  designationId  String?   @map("designation_id") @db.Uuid
  status         String    @default("ACTIVE") // INVITED, ACTIVE, SUSPENDED, DEACTIVATED
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation       Organisation?       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  sessions           Session[]
  accounts           Account[]
  userRoles          UserRole[]          @relation("UserAssignedRoles")
  assignedRoles      UserRole[]          @relation("AssignedByUser")
  projectMemberships ProjectMembership[]
  sentInvitations    Invitation[]        @relation("InvitedByUser")
  auditLogs          AuditLog[]          @relation("AuditActor")

  // CRM relations
  assignedLeads         Lead[]               @relation("LeadAssigned")
  createdLeads          Lead[]               @relation("LeadCreatedBy")
  leadAssignmentsTo     LeadAssignment[]     @relation("LeadAssignedTo")
  leadAssignmentsBy     LeadAssignment[]     @relation("LeadAssignedBy")
  createdCustomers      Customer[]           @relation("CustomerCreatedBy")
  customerNotes         CustomerNote[]       @relation("CustomerNoteCreatedBy")
  assignedFollowUps     FollowUp[]           @relation("FollowUpAssigned")
  createdFollowUps      FollowUp[]           @relation("FollowUpCreatedBy")
  assignedSiteVisits    SiteVisit[]          @relation("SiteVisitAssigned")
  createdSiteVisits     SiteVisit[]          @relation("SiteVisitCreatedBy")
  uploadedAttachments   SiteVisitAttachment[] @relation("SiteVisitAttachmentUploadedBy")
  leadActivitiesActor   LeadActivity[]       @relation("LeadActivityActor")

  // Estimation relations
  createdEstimates      Estimate[]           @relation("EstimateCreatedBy")
  createdQuotations     Quotation[]          @relation("QuotationCreatedBy")
  approvedQuotations    QuotationApproval[]  @relation("QuotationApprovedBy")

  // Project Management relations
  managedProjects       Project[]            @relation("ProjectManager")
  createdProjects       Project[]            @relation("ProjectCreatedBy")
  assignedTasks         ProjectTask[]        @relation("TaskAssignedTo")
  createdTasks          ProjectTask[]        @relation("TaskCreatedBy")
  taskComments          ProjectTaskComment[] @relation("TaskCommentAuthor")
  uploadedDocuments     ProjectDocument[]    @relation("DocumentUploadedBy")
  projectActivities     ProjectActivity[]    @relation("ProjectActivityActor")
  assignedMilestones    ProjectMilestone[]   @relation("MilestoneResponsibleUser")

  @@index([organisationId])
  @@index([departmentId])
  @@index([designationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("verifications")
}

// ==============================================================================
// ORGANISATION STRUCTURE (DEPARTMENTS & DESIGNATIONS)
// ==============================================================================

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  organisationId     String   @map("organisation_id") @db.Uuid
  name               String
  code               String
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  status             String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments   Department[] @relation("DepartmentHierarchy")
  users            User[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("departments")
}

model Designation {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  code           String
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("designations")
}

// ==============================================================================
// RBAC (ROLES, PERMISSIONS, ASSIGNMENTS, PROJECT ACCESS)
// ==============================================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g., users.view, users.create, roles.manage
  module      String   // e.g., users, organisation, roles, audit
  action      String   // e.g., view, create, update, manage, approve
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  code           String
  description    String?
  isSystemRole   Boolean  @default(false) @map("is_system_role")
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  scopeType      String   @default("ORGANISATION") @map("scope_type") // ORGANISATION, DEPARTMENT, PROJECT, SELF
  effect         String   @default("ALLOW") // ALLOW, DENY
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([organisationId])
  @@map("role_permissions")
}

model UserRole {
  id               String   @id @default(uuid()) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation("UserAssignedRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("AssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([organisationId])
  @@map("user_roles")
}

model ProjectMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  projectRole    String   @map("project_role") // PROJECT_MANAGER, SITE_ENGINEER, ARCHITECT_DESIGNER, QA_QC, CONSULTANT
  status         String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project      @relation("ProjectMemberships", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organisationId, projectId, userId])
  @@index([organisationId])
  @@index([projectId])
  @@index([userId])
  @@map("project_memberships")
}

// ==============================================================================
// INVITATIONS & AUDIT LOGS
// ==============================================================================

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  email           String
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  roleId          String?   @map("role_id") @db.Uuid
  departmentId    String?   @map("department_id") @db.Uuid
  designationId   String?   @map("designation_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  status          String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  metadataJson   Json?    @map("metadata_json")
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, occurredAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ==============================================================================
// CRM — LEAD SOURCES (ORG-SCOPED, CONFIGURABLE)
// ==============================================================================

model LeadSource {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("lead_sources")
}

// ==============================================================================
// CRM — LEAD PIPELINE STAGES (ORG-SCOPED, CONFIGURABLE)
// ==============================================================================

model LeadPipelineStage {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  code           String
  description    String?
  order          Int
  isTerminal     Boolean  @default(false) @map("is_terminal")
  isActive       Boolean  @default(true) @map("is_active")
  color          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leads          Lead[]
  stageHistoryTo   LeadStageHistory[] @relation("StageHistoryTo")
  stageHistoryFrom LeadStageHistory[] @relation("StageHistoryFrom")

  @@unique([organisationId, code])
  @@unique([organisationId, order])
  @@index([organisationId])
  @@map("lead_pipeline_stages")
}

// ==============================================================================
// CRM — LOST REASON CATEGORIES (ORG-SCOPED, CONFIGURABLE)
// ==============================================================================

model LostReasonCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  code           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("lost_reason_categories")
}

// ==============================================================================
// CRM — LEADS
// ==============================================================================

model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  leadNumber       String    @map("lead_number")
  customerName     String    @map("customer_name")
  phone            String?
  email            String?
  location         String?
  propertyType     String?   @map("property_type")
  projectCategory  String?   @map("project_category")
  requirements     String?
  estimatedBudget  Decimal?  @map("estimated_budget") @db.Decimal(15, 2)
  expectedStartDate DateTime? @map("expected_start_date") @db.Date
  sourceId         String?   @map("source_id") @db.Uuid
  assignedUserId   String?   @map("assigned_user_id") @db.Uuid
  priority         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status           String    @default("OPEN") // OPEN, WON, LOST, ARCHIVED
  pipelineStageId  String?   @map("pipeline_stage_id") @db.Uuid
  lastContactedDate DateTime? @map("last_contacted_date") @db.Timestamptz(6)
  nextFollowUpDate DateTime? @map("next_follow_up_date") @db.Timestamptz(6)
  lostReasonId     String?   @map("lost_reason_id") @db.Uuid
  lostRemarks      String?   @map("lost_remarks")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation  Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  source        LeadSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  assignedUser  User?               @relation("LeadAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser User?               @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  pipelineStage LeadPipelineStage?  @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  lostReason    LostReasonCategory? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  stageHistory  LeadStageHistory[]
  assignments   LeadAssignment[]
  followUps     FollowUp[]          @relation("LeadFollowUps")
  siteVisits    SiteVisit[]         @relation("LeadSiteVisits")
  activities    LeadActivity[]
  customer      Customer?           @relation("ConvertedFromLead")
  estimates     Estimate[]          @relation("LeadEstimates")

  @@unique([organisationId, leadNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, pipelineStageId])
  @@index([assignedUserId])
  @@index([sourceId])
  @@map("leads")
}

// ==============================================================================
// CRM — LEAD STAGE HISTORY
// ==============================================================================

model LeadStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  fromStageId     String?  @map("from_stage_id") @db.Uuid
  toStageId       String   @map("to_stage_id") @db.Uuid
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  remarks         String?
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage LeadPipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   LeadPipelineStage  @relation("StageHistoryTo", fields: [toStageId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_stage_history")
}

// ==============================================================================
// CRM — LEAD ASSIGNMENTS
// ==============================================================================

model LeadAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  leadId           String   @map("lead_id") @db.Uuid
  assignedToUserId String   @map("assigned_to_user_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  remarks          String?
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("LeadAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assignedToUserId])
  @@map("lead_assignments")
}

// ==============================================================================
// CRM — CUSTOMERS
// ==============================================================================

model Customer {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  customerNumber      String    @map("customer_number")
  type                String    @default("INDIVIDUAL") // INDIVIDUAL, COMPANY
  name                String
  legalName           String?   @map("legal_name")
  phone               String?
  email               String?
  billingAddress      String?   @map("billing_address")
  status              String    @default("ACTIVE") // ACTIVE, INACTIVE
  convertedFromLeadId String?   @unique @map("converted_from_lead_id") @db.Uuid
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  convertedFromLead Lead?          @relation("ConvertedFromLead", fields: [convertedFromLeadId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  contacts        CustomerContact[]
  addresses       CustomerAddress[]
  notes           CustomerNote[]
  followUps       FollowUp[]       @relation("CustomerFollowUps")
  siteVisits      SiteVisit[]      @relation("CustomerSiteVisits")
  estimates       Estimate[]       @relation("CustomerEstimates")
  quotations      Quotation[]      @relation("CustomerQuotations")
  projects        Project[]        @relation("CustomerProjects")

  @@unique([organisationId, customerNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("customers")
}

// ==============================================================================
// CRM — CUSTOMER CONTACTS
// ==============================================================================

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  phone      String?
  email      String?
  role       String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

// ==============================================================================
// CRM — CUSTOMER ADDRESSES
// ==============================================================================

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  type       String   @default("SITE") // BILLING, SITE, CORRESPONDENCE
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ==============================================================================
// CRM — CUSTOMER NOTES
// ==============================================================================

model CustomerNote {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  content         String
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CustomerNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_notes")
}

// ==============================================================================
// CRM — FOLLOW-UPS
// ==============================================================================

model FollowUp {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  leadId           String?   @map("lead_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  type             String    // CALL, WHATSAPP, EMAIL, MEETING
  scheduledAt      DateTime  @map("scheduled_at") @db.Timestamptz(6)
  assignedUserId   String?   @map("assigned_user_id") @db.Uuid
  status           String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  notes            String?
  outcome          String?
  reminderAt       DateTime? @map("reminder_at") @db.Timestamptz(6)
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation("CustomerFollowUps", fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User?        @relation("FollowUpAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("FollowUpCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([leadId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([organisationId, status, scheduledAt])
  @@map("follow_ups")
}

// ==============================================================================
// CRM — SITE VISITS
// ==============================================================================

model SiteVisit {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  leadId           String?   @map("lead_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  assignedUserId   String?   @map("assigned_user_id") @db.Uuid
  visitDate        DateTime  @map("visit_date") @db.Timestamptz(6)
  address          String?
  status           String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  remarks          String?
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead?              @relation("LeadSiteVisits", fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation("CustomerSiteVisits", fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User?              @relation("SiteVisitAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("SiteVisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attachments  SiteVisitAttachment[]

  @@index([organisationId])
  @@index([leadId])
  @@index([customerId])
  @@index([assignedUserId])
  @@map("site_visits")
}

// ==============================================================================
// CRM — SITE VISIT ATTACHMENTS (STORAGE ABSTRACTION)
// ==============================================================================

model SiteVisitAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  siteVisitId      String   @map("site_visit_id") @db.Uuid
  fileName         String   @map("file_name")
  fileKey          String   @map("file_key")
  fileSize         Int?     @map("file_size")
  mimeType         String?  @map("mime_type")
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  siteVisit  SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("SiteVisitAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([siteVisitId])
  @@map("site_visit_attachments")
}

// ==============================================================================
// CRM — LEAD ACTIVITY TIMELINE
// ==============================================================================

model LeadActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  activityType   String   @map("activity_type") // CREATED, STAGE_CHANGED, ASSIGNED, NOTE_ADDED, FOLLOW_UP_SCHEDULED, SITE_VISIT_SCHEDULED, STATUS_CHANGED, CONVERTED, etc.
  description    String
  metadataJson   Json?    @map("metadata_json")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor        User?        @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([organisationId])
  @@map("lead_activities")
}


// ==============================================================================
// PHASE 2 — ESTIMATION, BOQ & QUOTATION MODULE
// ==============================================================================

// ------------------------------------------------------------------------------
// MATERIAL LIBRARY & RATES
// ------------------------------------------------------------------------------

model MaterialCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  description    String?
  parentId       String?  @map("parent_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent         MaterialCategory?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories  MaterialCategory[]  @relation("CategoryHierarchy")
  materials      Material[]

  @@unique([organisationId, name, parentId])
  @@index([organisationId])
  @@map("material_categories")
}

model Material {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String
  sku            String   @map("sku") // unique per org
  description    String?
  unit           String   // e.g. SQFT, RFT, BAG, TON, NOS, CUM, KG, LTR
  standardRate   Decimal  @default(0.00) @map("standard_rate") @db.Decimal(18, 2)
  vendorRate     Decimal? @map("vendor_rate") @db.Decimal(18, 2)
  preferredVendor String? @map("preferred_vendor")
  hsnCode        String?  @map("hsn_code")
  taxRate        Decimal  @default(18.00) @map("tax_rate") @db.Decimal(5, 2) // default GST %
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  category     MaterialCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rateHistory  MaterialRateHistory[]
  boqItems     BoqItem[]

  @@unique([organisationId, sku])
  @@index([organisationId, status])
  @@index([organisationId, name])
  @@map("materials")
}

model MaterialRateHistory {
  id             String   @id @default(uuid()) @db.Uuid
  materialId     String   @map("material_id") @db.Uuid
  rate           Decimal  @db.Decimal(18, 2)
  vendorRate     Decimal? @map("vendor_rate") @db.Decimal(18, 2)
  changedByUserId String? @map("changed_by_user_id") @db.Uuid
  reason         String?
  effectiveFrom  DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, effectiveFrom])
  @@map("material_rate_history")
}

// ------------------------------------------------------------------------------
// LABOUR & SERVICE RATE LIBRARY
// ------------------------------------------------------------------------------

model LabourCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  labourRates  LabourRate[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("labour_categories")
}

model LabourRate {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  workDescription String  @map("work_description")
  code           String   @map("code") // e.g. LAB-CIV-001
  unit           String   // e.g. SQFT, RFT, DAY, HOUR, POINT, NOS
  standardRate   Decimal  @default(0.00) @map("standard_rate") @db.Decimal(18, 2)
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  category     LabourCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rateHistory  LabourRateHistory[]
  boqItems     BoqItem[]

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("labour_rates")
}

model LabourRateHistory {
  id             String   @id @default(uuid()) @db.Uuid
  labourRateId   String   @map("labour_rate_id") @db.Uuid
  rate           Decimal  @db.Decimal(18, 2)
  changedByUserId String? @map("changed_by_user_id") @db.Uuid
  reason         String?
  effectiveFrom  DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)

  labourRate LabourRate @relation(fields: [labourRateId], references: [id], onDelete: Cascade)

  @@index([labourRateId, effectiveFrom])
  @@map("labour_rate_history")
}

// ------------------------------------------------------------------------------
// BOQ TEMPLATES (REUSABLE PACKAGES)
// ------------------------------------------------------------------------------

model BoqTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  projectCategory String  @map("project_category") // RESIDENTIAL_CONSTRUCTION, RESIDENTIAL_INTERIOR, etc.
  description    String?
  templateData   Json     @map("template_data") // Structured sections, items, default units & multipliers
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, projectCategory])
  @@map("boq_templates")
}

// ------------------------------------------------------------------------------
// ESTIMATES & BOQ INSTANCES
// ------------------------------------------------------------------------------

model Estimate {
  id              String   @id @default(uuid()) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  estimateNumber  String   @map("estimate_number") // EST-00001
  title           String
  description     String?
  projectCategory String   @map("project_category") // RESIDENTIAL_CONSTRUCTION, COMMERCIAL_CONSTRUCTION, RESIDENTIAL_INTERIOR, COMMERCIAL_INTERIOR, RENOVATION, TURNKEY
  projectLocation String?  @map("project_location")
  leadId          String?  @map("lead_id") @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  status          String   @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, REVISED, ARCHIVED
  currency        String   @default("INR")
  
  // Revision tracking
  revisionNumber  Int      @default(1) @map("revision_number")
  parentEstimateId String? @map("parent_estimate_id") @db.Uuid

  // Financial aggregates calculated decimal-safe
  totalMaterialCost Decimal @default(0.00) @map("total_material_cost") @db.Decimal(18, 2)
  totalLabourCost   Decimal @default(0.00) @map("total_labour_cost") @db.Decimal(18, 2)
  totalOtherCharges Decimal @default(0.00) @map("total_other_charges") @db.Decimal(18, 2)
  subtotalCost      Decimal @default(0.00) @map("subtotal_cost") @db.Decimal(18, 2) // mat + lab + other
  
  wastagePercent    Decimal @default(0.00) @map("wastage_percent") @db.Decimal(5, 2)
  wastageAmount     Decimal @default(0.00) @map("wastage_amount") @db.Decimal(18, 2)
  
  overheadPercent   Decimal @default(0.00) @map("overhead_percent") @db.Decimal(5, 2)
  overheadAmount    Decimal @default(0.00) @map("overhead_amount") @db.Decimal(18, 2)
  
  profitMarginPercent Decimal @default(0.00) @map("profit_margin_percent") @db.Decimal(5, 2)
  profitMarginAmount  Decimal @default(0.00) @map("profit_margin_amount") @db.Decimal(18, 2)
  
  discountPercent   Decimal @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount    Decimal @default(0.00) @map("discount_amount") @db.Decimal(18, 2)
  
  taxPercent        Decimal @default(18.00) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount         Decimal @default(0.00) @map("tax_amount") @db.Decimal(18, 2)
  
  grandTotal        Decimal @default(0.00) @map("grand_total") @db.Decimal(18, 2)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead           Lead?          @relation("LeadEstimates", fields: [leadId], references: [id], onDelete: SetNull)
  customer       Customer?      @relation("CustomerEstimates", fields: [customerId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("EstimateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parentEstimate Estimate?      @relation("EstimateRevisions", fields: [parentEstimateId], references: [id], onDelete: SetNull)
  revisions      Estimate[]     @relation("EstimateRevisions")
  
  sections       BoqSection[]
  quotations     Quotation[]

  @@unique([organisationId, estimateNumber, revisionNumber])
  @@index([organisationId, status])
  @@index([leadId])
  @@index([customerId])
  @@map("estimates")
}

model BoqSection {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  title       String   // e.g. Civil Works, Flooring, Electrical, Modular Kitchen
  description String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  estimate    Estimate    @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  items       BoqItem[]

  @@index([estimateId, orderIndex])
  @@map("boq_sections")
}

model BoqItem {
  id             String   @id @default(uuid()) @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  orderIndex     Int      @default(0) @map("order_index")
  description    String   // Work / Item description
  
  // Material component
  materialId     String?  @map("material_id") @db.Uuid
  materialQty    Decimal  @default(0.00) @map("material_qty") @db.Decimal(18, 4)
  materialUnit   String?  @map("material_unit")
  materialRate   Decimal  @default(0.00) @map("material_rate") @db.Decimal(18, 2)
  materialTotal  Decimal  @default(0.00) @map("material_total") @db.Decimal(18, 2)
  
  // Labour component
  labourRateId   String?  @map("labour_rate_id") @db.Uuid
  labourQty      Decimal  @default(0.00) @map("labour_qty") @db.Decimal(18, 4)
  labourUnit     String?  @map("labour_unit")
  labourRate     Decimal  @default(0.00) @map("labour_rate") @db.Decimal(18, 2)
  labourTotal    Decimal  @default(0.00) @map("labour_total") @db.Decimal(18, 2)

  // Other component
  otherCharges   Decimal  @default(0.00) @map("other_charges") @db.Decimal(18, 2)
  
  // Line item total
  itemTotal      Decimal  @default(0.00) @map("item_total") @db.Decimal(18, 2) // materialTotal + labourTotal + otherCharges

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  section        BoqSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  material       Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  labour         LabourRate? @relation(fields: [labourRateId], references: [id], onDelete: SetNull)

  @@index([sectionId, orderIndex])
  @@map("boq_items")
}

// ------------------------------------------------------------------------------
// QUOTATIONS & COMMERCIAL APPROVAL WORKFLOW
// ------------------------------------------------------------------------------

model Quotation {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  quotationNumber String    @map("quotation_number") // QT-00001
  revisionNumber  Int       @default(1) @map("revision_number")
  estimateId      String    @map("estimate_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  title           String
  
  // Status workflow: DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, DISPATCHED, ACCEPTED, DECLINED
  status          String    @default("DRAFT")
  
  // Commercial details
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(6)
  termsAndConditions String? @map("terms_and_conditions")
  paymentSchedule Json?     @map("payment_schedule") // Milestones & % payments
  
  // Financial Snapshot
  subtotal        Decimal   @default(0.00) @db.Decimal(18, 2)
  discountAmount  Decimal   @default(0.00) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal   @default(0.00) @map("tax_amount") @db.Decimal(18, 2)
  grandTotal      Decimal   @default(0.00) @map("grand_total") @db.Decimal(18, 2)
  currency        String    @default("INR")

  // Dispatch details
  dispatchedAt    DateTime? @map("dispatched_at") @db.Timestamptz(6)
  dispatchedTo    String?   @map("dispatched_to")

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation    Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  estimate        Estimate            @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation("CustomerQuotations", fields: [customerId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation("QuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvals       QuotationApproval[]
  createdProjects Project[]           @relation("QuotationProjects")

  @@unique([organisationId, quotationNumber, revisionNumber])
  @@index([organisationId, status])
  @@index([estimateId])
  @@index([customerId])
  @@map("quotations")
}

model QuotationApproval {
  id             String   @id @default(uuid()) @db.Uuid
  quotationId    String   @map("quotation_id") @db.Uuid
  approverUserId String?  @map("approver_user_id") @db.Uuid
  decision       String   // APPROVED, REJECTED
  comments       String?
  decidedAt      DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver  User?     @relation("QuotationApprovedBy", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([quotationId, decidedAt])
  @@map("quotation_approvals")
}

// ==============================================================================
// PHASE 3: PROJECT MANAGEMENT & EXECUTION MODELS
// ==============================================================================

model Project {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  projectNumber       String    @map("project_number") // PRJ-00001
  name                String
  description         String?
  projectCategory     String    @map("project_category") // RESIDENTIAL_INTERIOR, RESIDENTIAL_CONSTRUCTION, COMMERCIAL_INTERIOR, COMMERCIAL_CONSTRUCTION, RENOVATION, TURNKEY
  siteAddress         String?   @map("site_address")
  
  // Status & Priority
  status              String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  // Schedule
  startDate           DateTime? @map("start_date") @db.Timestamptz(6)
  expectedEndDate     DateTime? @map("expected_end_date") @db.Timestamptz(6)
  actualCompletionDate DateTime? @map("actual_completion_date") @db.Timestamptz(6)
  
  // Progress (Derived from backend calculations: 0 - 100)
  progressPercentage  Decimal   @default(0.00) @map("progress_percentage") @db.Decimal(5, 2)
  manualProgressOverride Boolean @default(false) @map("manual_progress_override")

  // Relationships
  customerId          String?   @map("customer_id") @db.Uuid
  projectManagerId    String?   @map("project_manager_id") @db.Uuid
  
  // Commercial Baseline: Exact immutable accepted quotation revision
  sourceQuotationId   String?   @map("source_quotation_id") @db.Uuid
  sourceQuotationNumber String? @map("source_quotation_number")
  sourceQuotationRevision Int?  @map("source_quotation_revision")
  
  // Budget Baseline (Fixed snapshot of accepted quotation)
  budgetBaselineAmount Decimal  @default(0.00) @map("budget_baseline_amount") @db.Decimal(18, 2)
  approvedBoqSnapshot Json?     @map("approved_boq_snapshot") // Frozen copy of sections & items
  currency            String    @default("INR")

  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer            Customer?           @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: SetNull)
  projectManager      User?               @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  sourceQuotation     Quotation?          @relation("QuotationProjects", fields: [sourceQuotationId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  memberships         ProjectMembership[] @relation("ProjectMemberships")
  milestones          ProjectMilestone[]
  tasks               ProjectTask[]
  documents           ProjectDocument[]
  activities          ProjectActivity[]

  @@unique([organisationId, projectNumber])
  @@index([organisationId, status])
  @@index([organisationId, projectManagerId])
  @@index([customerId])
  @@index([sourceQuotationId])
  @@map("projects")
}

model ProjectMilestoneTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  name            String
  projectCategory String   @map("project_category")
  description     String?
  templateData    Json     @map("template_data") // Array of predefined phases/milestones with sequences
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, projectCategory])
  @@map("project_milestone_templates")
}

model ProjectMilestone {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  name                String
  phaseName           String    @map("phase_name") // e.g. "Initial Planning", "Execution"
  description         String?
  sequenceOrder       Int       @default(1) @map("sequence_order")
  
  // Status: NOT_STARTED, IN_PROGRESS, COMPLETED, DELAYED
  status              String    @default("NOT_STARTED")
  progressPercentage  Decimal   @default(0.00) @map("progress_percentage") @db.Decimal(5, 2)
  
  // Schedule
  plannedStartDate    DateTime? @map("planned_start_date") @db.Timestamptz(6)
  plannedEndDate      DateTime? @map("planned_end_date") @db.Timestamptz(6)
  actualCompletionDate DateTime? @map("actual_completion_date") @db.Timestamptz(6)
  
  // Dependencies (Self-referential Milestone dependency)
  predecessorMilestoneId String? @map("predecessor_milestone_id") @db.Uuid

  responsibleUserId   String?   @map("responsible_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsibleUser     User?             @relation("MilestoneResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  predecessor         ProjectMilestone? @relation("MilestoneDependency", fields: [predecessorMilestoneId], references: [id], onDelete: SetNull)
  dependentMilestones ProjectMilestone[] @relation("MilestoneDependency")
  tasks               ProjectTask[]

  @@index([organisationId])
  @@index([projectId, sequenceOrder])
  @@map("project_milestones")
}

model ProjectTask {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  milestoneId         String?   @map("milestone_id") @db.Uuid
  title               String
  description         String?
  
  // Status & Priority
  status              String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED, CANCELLED
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  // Schedule
  startDate           DateTime? @map("start_date") @db.Timestamptz(6)
  dueDate             DateTime? @map("due_date") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)

  // Assignee
  assigneeUserId      String?   @map("assignee_user_id") @db.Uuid
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone           ProjectMilestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee            User?                @relation("TaskAssignedTo", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  comments            ProjectTaskComment[]

  @@index([organisationId, status])
  @@index([projectId, status])
  @@index([milestoneId])
  @@index([assigneeUserId])
  @@map("project_tasks")
}

model ProjectTaskComment {
  id             String      @id @default(uuid()) @db.Uuid
  taskId         String      @map("task_id") @db.Uuid
  authorUserId   String?     @map("author_user_id") @db.Uuid
  content        String
  attachments    Json?       // Optional array of file metadata
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  task           ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User?       @relation("TaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("project_task_comments")
}

model ProjectDocument {
  id              String   @id @default(uuid()) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  title           String
  category        String   // DRAWINGS, CLIENT_APPROVALS, CONTRACTS, SITE_PHOTOGRAPHS, TECHNICAL_SPECS, OTHER
  fileName        String   @map("file_name")
  fileSize        Int      @map("file_size") // In bytes
  mimeType        String   @map("mime_type")
  fileUrl         String   @map("file_url")
  description     String?
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy      User?        @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([projectId, category])
  @@map("project_documents")
}

model ProjectActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   // project.created, task.completed, milestone.updated, member.assigned, etc.
  description    String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor          User?        @relation("ProjectActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([projectId, createdAt])
  @@map("project_activities")
}
