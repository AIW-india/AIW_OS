{
  "name": "@aiw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/tests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:test": "tsx src/scripts/test-db-connection.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:verify": "tsx prisma/seed.ts --verify"
  },
  "dependencies": {
    "@aiw/shared-types": "*",
    "@aiw/validation": "*",
    "@prisma/client": "^5.14.0",
    "@types/multer": "^2.3.0",
    "better-auth": "^1.7.28",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jspdf": "^4.2.1",
    "multer": "^2.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  }
}
